NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ================================================================
# EMAIL REMINDER SETTINGS (Nodemailer / SMTP)
# ================================================================
# Contoh menggunakan akun Gmail (Gunakan App Password 16 karakter):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=official@e17course.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM="E17 Course" <official@e17course.com>

# Contoh menggunakan Brevo / Mailgun / SMTP Relay kustom:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="E17 Course" <no-reply@e17course.com>

# Kunci otorisasi pengaman endpoint cron harian (/api/cron/daily-class-reminder)
CRON_SECRET=e17_cron_daily_reminder_secret_key
