import type { DefaultSession } from "next-auth";

declare module "next-auth" {
  interface Session {
    user: {
      id: string;
      role: "PESERTA" | "INSTRUKTUR" | "ADMIN";
    } & DefaultSession["user"];
  }

  interface User {
    role?: "PESERTA" | "INSTRUKTUR" | "ADMIN";
  }
}

declare module "next-auth/jwt" {
  interface JWT {
    id?: string;
    role?: "PESERTA" | "INSTRUKTUR" | "ADMIN";
  }
}
